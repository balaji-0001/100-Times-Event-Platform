# Read by docker-compose.yml (docker compose auto-loads a .env file next to
# it). This is separate from artifacts/api-server/.env, which FastAPI reads
# directly — copy this to `.env` here only if you're running the Docker
# infrastructure (n8n / Postgres / optional containerized FastAPI).

# Required by n8n to encrypt stored credentials. Generate a random 32+ char
# string and keep it stable — rotating it invalidates n8n's saved credentials.
N8N_ENCRYPTION_KEY=change-this-to-a-random-32-plus-character-string

# Only used if you switch DATABASE_URL to point at the Postgres container
# for production-parity testing (SQLite remains the default local dev DB).
POSTGRES_PASSWORD=devpassword
