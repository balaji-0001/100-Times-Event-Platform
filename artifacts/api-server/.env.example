# ==============================================================================
# 100 TIMES EVENT PLATFORM — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# --- Core Server & Database ---
# Supported DB URLs:
#   MySQL:      mysql+pymysql://<user>:<password>@<host>:3306/<database>?charset=utf8mb4
#   SQLite:     sqlite:///./100times-dev.db
APP_NAME="100 TIMES API"
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./100times-dev.db"
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS="*"
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
APP_BASE_URL="http://127.0.0.1:8000"
PLATFORM_LISTING_URL="https://100times.in"

# --- AI Provider (Gemini default, or Anthropic) ---
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Trust Agent (Agent 3) Configuration ---
TRUST_AGENT_AUTO_APPROVE_SCORE=75
TRUST_AGENT_MIN_DESCRIPTION_LENGTH=25
TRUST_AGENT_MAX_DAILY_SUBMISSIONS_PER_ORGANIZER=10

# --- Organizer & Attendee Follow-up Cadence ---
ORGANIZER_FOLLOWUP_MAX_ATTEMPTS=3
ORGANIZER_FOLLOWUP_FIRST_WAIT_DAYS=1
ORGANIZER_FOLLOWUP_SECOND_WAIT_DAYS=2

# --- n8n Automation & Webhook Security ---
N8N_URL="http://localhost:5678"
N8N_ENCRYPTION_KEY=""
N8N_WEBHOOK_SECRET="dev-n8n-webhook-secret-100times"
N8N_WEBHOOKS_ENABLED=false
CALENDAR_PROVIDER="ics"

# --- Email Provider (SMTP / Mock Fallback) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@100times.in"
SMTP_USE_TLS=true

# --- Attendee Agent & Social Community Connectors ---
TELEGRAM_BOT_TOKEN=""
DISCORD_BOT_TOKEN=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_REDIRECT_URI=""
X_BEARER_TOKEN=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""
SOCIAL_AGENT_DAILY_CAP_PER_PLATFORM=25

# --- Agent 1 (Event Discovery) & Agent 2 (Organizer Outreach) ---
OUTREACH_MATCH_THRESHOLD=80
OUTREACH_DAILY_CAP=10
OUTREACH_FOLLOWUP_DAYS=7
DISCOVERY_DAILY_LIMIT=200
DISCOVERY_CONFIDENCE_THRESHOLD=60
# Re-open JavaScript-rendered pages in headless Chromium (Playwright).
# One-time setup: python -m playwright install chromium
DISCOVERY_BROWSER_FETCH=true
# Listing pages read without any AI key ({city} = each DISCOVERY_TARGET_CITIES entry).
# Leave unset for the built-in list (allevents.in, Eventbrite, Meetup, SkillBox); set empty to use AI search only.
# DISCOVERY_LISTING_URLS=https://allevents.in/{city},https://www.eventbrite.com/d/india--{city}/events/
DISCOVERY_EVENTS_PER_LISTING=25

# --- Discovery: General Web Search providers (backend only; never sent to the browser) ---
# A provider runs only when configured here AND ticked in Discovery settings.
# SearXNG: free, self-hosted, asked first.  docker compose up -d searxng
SEARXNG_URL=""
# Exa: paid (~$0.007/search), tops up when SearXNG returns too few results.
EXA_API_KEY=""
# Google: uses GEMINI_API_KEY above (Gemini "Grounding with Google Search"; billed per
# grounded request on that key's plan). The Custom Search JSON API below no longer
# accepts new customers — new keys get HTTP 403.
GOOGLE_SEARCH_API_KEY=""
GOOGLE_CSE_ID=""
BRAVE_SEARCH_API_KEY=""
# Bing Search APIs were retired by Microsoft (Aug 2025); kept for old configs only.
BING_SEARCH_API_KEY=""
# free_first (default): free providers first, paid ones one at a time only while short.
# parallel: every selected provider for every query.
SEARCH_STRATEGY="free_first"
# Most paid search calls one discovery run may make (discovery + organizer lookups).
PAID_SEARCH_CALLS_PER_RUN=60

# --- Discovery: Event platform APIs ---
# Ticketmaster Discovery API v2 (free key: developer.ticketmaster.com). Can also be saved
# from the Discovery settings page; it is never returned to the browser.
TICKETMASTER_API_KEY=""
ENABLE_BACKGROUND_SCHEDULER=false
