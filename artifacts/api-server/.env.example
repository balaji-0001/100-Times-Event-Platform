# Choose exactly one DATABASE_URL. Never commit a real password or JWT secret.
# PostgreSQL (recommended when PostgreSQL is installed locally, or via
# `docker compose up -d postgres` — see ../../docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://hundredtimes:devpassword@127.0.0.1:5433/hundredtimes
# SQLite fallback for self-contained local development (default — no
# migration required, this is the primary supported local dev path):
DATABASE_URL=sqlite:///./100times-dev.db

ENVIRONMENT=development
# Use * only for local development. Production should use explicit origins.
CORS_ORIGINS=*
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
# JWT_SECRET=replace-this-with-a-long-random-value

# --- Social Media Attendee Acquisition Agent -------------------------------
# Every connector's real status (REAL / MOCK / NOT_CONFIGURED /
# APPROVAL_REQUIRED / ERROR) is visible at GET /api/acquisition/connectors/status.
# Reddit, X, LinkedIn, and Instagram require the PLATFORM's own approval
# (commercial API access / app review) before a credential alone is enough —
# see the platform-by-platform notes below. Discord and Telegram need only a
# credential you can obtain yourself, no approval process.

# Reddit — Data API access requires filing Reddit's Responsible Builder
# Policy approval request before these credentials do anything real:
# https://support.reddithelp.com/hc/en-us/articles/14945211791892
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# One-time use only (the refresh-token minting script), never a live callback route:
# REDDIT_REDIRECT_URI=http://localhost:8080

# Discord — no approval needed; create a Bot in the Developer Portal
# (discord.com/developers/applications) and invite it to servers you're
# authorized to operate in.
# DISCORD_BOT_TOKEN=

# Telegram — no approval needed; get a token from @BotFather. The only
# platform with a fully real, working connector + publisher in this codebase.
# TELEGRAM_BOT_TOKEN=

# X (Twitter) — commercial write access currently requires a paid API tier;
# verify current pricing/tiers at developer.x.com before budgeting around it.
# X_BEARER_TOKEN=       # app-only bearer, read/discovery side only
# X_API_KEY=            # OAuth2 client id — publish side, once approved
# X_API_SECRET=

# LinkedIn — posting requires LinkedIn's manual review of the Community
# Management API product; only supports posting to your OWN profile/Company
# Page, never replying to other members' posts.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Instagram — requires a Business/Creator account + Meta App Review for the
# instagram_content_publish permission; content-distribution only (no reply
# capability exists on Instagram's API for any developer).
# INSTAGRAM_ACCESS_TOKEN=

# Max new discussions ingested per platform per day (spam/rate-limit guard).
# Overridable per platform via PATCH /api/acquisition/rate-limits/{platform}.
SOCIAL_AGENT_DAILY_CAP_PER_PLATFORM=25

# --- AI provider (services/social_agent/ai_client.py) ----------------------
# Which LLM powers discovery web research, page extraction, outreach drafting
# and the social pipeline: "gemini" (Google) or "anthropic" (Claude). Only the
# selected provider's key is required. Without it, AI-dependent stages fail
# honestly (FAILED_AI_EXTRACTION / failed AgentRun) instead of silently
# falling back to keyword matching. Never commit a real key.
AI_PROVIDER=gemini
# GEMINI_API_KEY=
# Any Gemini model your key can access; Pro for extraction quality, a Flash
# model to cut cost. Discovery needs Google Search grounding support.
GEMINI_MODEL=gemini-flash-lite-latest
# Only used when AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# How long after a tracked click a registration still counts as attributed.
CLICK_ATTRIBUTION_WINDOW_DAYS=30

# Where this backend is actually reachable — used to build real /r/{id}
# click-tracking redirect links (not a fictional domain).
APP_BASE_URL=http://127.0.0.1:8000

# --- n8n orchestration layer (see ../../infra/n8n/README.md) ---------------
# Not read by FastAPI itself — n8n calls FastAPI, not the reverse — kept
# here so every external service's config lives in one place.
N8N_URL=http://localhost:5678
# Required by n8n itself (set in the root .env used by docker-compose.yml,
# not necessarily this one) — generate a random 32+ char string and keep it
# stable; rotating it invalidates n8n's already-saved credentials.
# N8N_ENCRYPTION_KEY=

# --- Background scheduler (services/social_agent/scheduler.py) -------------
# Makes BOTH agents run continuously with zero manual dashboard input —
# this is what "automatic" means in practice. Runs in-process, so it works
# with plain `uvicorn`, no Docker/n8n required. n8n's Schedule Trigger
# workflows (discovery.json, outreach_followup.json) remain a valid
# alternative; set this to false if you'd rather schedule from n8n only,
# so the two don't fire the same work twice.
ENABLE_BACKGROUND_SCHEDULER=false
ATTENDEE_SCAN_INTERVAL_MINUTES=15
ORGANIZER_SCAN_INTERVAL_MINUTES=30
OUTREACH_FOLLOWUP_INTERVAL_MINUTES=1440

# --- Organizer Outreach (services/social_agent/outreach/) -------------------
# Gate on the extracted event's match score (avg of the AI's confidence +
# relevance scores) before ever contacting an organizer. Keep outreach
# volume bounded with a real daily cap, not an unlimited auto-sender.
OUTREACH_MATCH_THRESHOLD=80
OUTREACH_DAILY_CAP=10
OUTREACH_FOLLOWUP_DAYS=7
# Bounds AI cost per automatic Organizer scan tick — each seed can trigger
# several Claude calls (intent extraction + up to 5 event-extraction calls).
ORGANIZER_DISCOVERY_MAX_SEEDS_PER_CYCLE=3

# Email sending for Organizer Outreach. No SMTP credential configured ->
# outreach emails are logged only (MockEmailProvider), never claimed as
# really sent. Works with any SMTP relay: a Gmail app password, SendGrid/
# Mailgun/Resend's own SMTP relay, a self-hosted mail server, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=outreach@yourdomain.example
# SMTP_USE_TLS=true
