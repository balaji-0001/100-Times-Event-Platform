{
  "name": "100.com - Processing (ad-hoc signal submission)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "100times/submit-signal",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "processing-webhook",
      "name": "Signal Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "100times-submit-signal"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/acquisition/test-discussion",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "processing-call-fastapi",
      "name": "Process Signal via FastAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "processing-respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Signal Webhook": {
      "main": [
        [
          {
            "node": "Process Signal via FastAPI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Signal via FastAPI": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "description": "For submitting a single signal from outside the normal scan cycle (e.g. an external source pushing a post in). Expects a POST body of {platform, communityName, title, content, url?}. All intent extraction / qualification / matching / content generation happens inside FastAPI's /test-discussion endpoint \u2014 this workflow is just the entry point."
  },
  "settings": {
    "executionOrder": "v1"
  }
}